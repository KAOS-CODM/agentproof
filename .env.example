# AgentProof Environment Configuration (P6)
# Copy this file to `.env` and fill in the operator-specific values. Never commit
# a real `.env`. SQLite is the default; MongoDB and live providers are opt-in.
# See README "Local Operator Setup (P6)" for the exact local runbook.

# API
PORT=3001
NODE_ENV=development

# SQLite database file used when PERSISTENCE_PROVIDER=sqlite. Relative paths are
# resolved from the API process working directory (apps/api with the workspace
# scripts), so this default is apps/api/data/agentproof.db.
DB_PATH=./data/agentproof.db

# Authentication (P5). There is no public registration and no registration route.
# The operator provisions the initial account at startup by setting BOTH values
# together. Provisioning is idempotent: an existing account is never modified or
# re-created, and the password is never logged. The initial password must be at
# least 12 characters.
#
# Server-side only: AUTH_INITIAL_PASSWORD must never be exposed to the frontend,
# browser bundles, logs, or generated files. With default SQLite the account is
# durable, so you may remove/blank these after verifying that sign-in still works
# following an API restart.
AUTH_INITIAL_EMAIL=
AUTH_INITIAL_PASSWORD=

# Server-side session lifetime in hours (default 24). Sessions are validated
# against expiry and revocation on every request; logout revokes the current one.
AUTH_SESSION_TTL_HOURS=24

# Session cookie `Secure` flag. Empty/unset means true when NODE_ENV=production
# and false otherwise. Set true whenever the app is served over HTTPS.
# The cookie is always HttpOnly, SameSite=Strict, and Path=/.
AUTH_COOKIE_SECURE=

# Browser origin allowed by CORS (with credentials) and by the Origin/Referer
# CSRF check for state-changing requests. Must be an explicit origin; never '*'.
WEB_ORIGIN=http://localhost:5173

# OpenRouter intent parsing (P2). Required for the bundled UI's natural-language
# intent form. Server-side only; never expose the key to the frontend.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# PayPal Sandbox (P4/P5/P6)
# PAYPAL_CLIENT_ID is the public Sandbox client ID. The backend uses it for
# server-side PayPal API calls, and the frontend reuses the same value for the
# JavaScript SDK v6 (see apps/web/vite.config.ts). Do not duplicate it.
# PAYPAL_CLIENT_SECRET must remain server-side only — never expose it to the
# frontend, browser bundles, logs, or generated files.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal checkout return URLs (P6 — automatic capture and evidence reconciliation)
# Uses hash-based routing so no server-side route config is needed. The frontend
# parses both location and hash query parameters.
# For production, set these to the public URLs of the deployed frontend.
PAYPAL_RETURN_URL=http://localhost:5173/#/payment/return
PAYPAL_CANCEL_URL=http://localhost:5173/#/payment/cancel

# Channel3 product discovery (Phase 3+)
# Server-side only - never expose CHANNEL3_API_KEY to the frontend, bundles,
# logs, or generated files. Get a free key at https://trychannel3.com.
CHANNEL3_API_KEY=

# Product-discovery source selection.
#   channel3 (default) -> live Channel3 API. Requires CHANNEL3_API_KEY; if the
#                         key is missing/invalid the API fails with a clear
#                         configuration error instead of falling back.
#   demo               -> in-memory DemoCatalogService, for development/tests
#                         only. Results are always labelled source=demo_catalog.
# There is never an automatic fallback to demo data when a live Channel3
# search fails - a fallback must be selected explicitly here.
DISCOVERY_PROVIDER=

# Retailer handoff (P7). Defaults to disabled: discovery still displays offers,
# but no "Continue to retailer" action or handoff endpoint is exposed.
# Enable only after verifying the outbound link policy for your Channel3 account.
RETAILER_HANDOFF_ENABLED=false
# Comma-separated EXACT hostnames allowed in addition to the merchant domain
# stored in each immutable offer snapshot. The documented Channel3 tracked-link
# host is the default. Set empty to allow merchant domains only. Hostnames are
# never matched by substring; subdomains of a merchant domain are allowed at a
# label boundary, tracking hosts must match exactly.
CHANNEL3_ALLOWED_LINK_HOSTS=buy.trychannel3.com

# MongoDB Atlas (P2-B/P3/P4/P5/P6 - opt-in persistence provider for intents,
# policy evaluations, evidence records, transactions, shared offers, per-intent
# discovery associations, users, sessions, per-user ownership, and saved-workflow
# history reads).
#
# Server-side only: MONGODB_URI contains credentials and must never be exposed
# to the frontend, bundles, logs, generated files, or API responses. Use a
# least-privilege database user and a restricted Atlas network access list.
# There is no fallback to SQLite/in-memory storage when these are missing - an
# explicit `PERSISTENCE_PROVIDER=mongodb` with missing values fails startup.
# Example URI shape (replace every <...>): mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=agentproof

# Persistence provider for the migrated domain repositories (P2-B/P3/P4/P5).
#   sqlite  (default) -> the in-process sql.js store; requires no MongoDB
#                        configuration. Offers use the `products` table and
#                        intent associations use `intent_discoveries`; accounts
#                        and sessions use `users`/`sessions`.
#   mongodb           -> MongoDB Atlas for intents, policy evaluations, evidence
#                        records, transactions, shared offers (`offers`),
#                        per-intent discovery associations (`intentDiscoveries`),
#                        accounts (`users`), and sessions (`sessions`). There is
#                        no hybrid product store. Connecting/indexing happens at
#                        startup; a connection or index failure aborts startup
#                        with NO fallback to SQLite.
# Selecting `mongodb` also stores per-user ownership for intents, policy
# evaluations, transactions, and evidence records. Both providers enforce the
# same authorization rules; there is no ownership fallback between them.
PERSISTENCE_PROVIDER=sqlite
